[Unit]
Description=Gamerkeyboard shutdown button (stop LED player, then power off)
After=network.target

[Service]
Type=simple
User=root
Environment=BUTTON_GPIO=17
Environment=HOLD_SECONDS=2
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /usr/local/bin/keyboard-shutdown-button.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
